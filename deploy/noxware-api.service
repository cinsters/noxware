# Alternative to Docker: run the API under systemd, Caddy via apt.
#
#   sudo cp deploy/noxware-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now noxware-api
#
# Then install Caddy (https://caddyserver.com/docs/install) and put
# deploy/Caddyfile at /etc/caddy/Caddyfile — but change the two
# `reverse_proxy api:3001` lines to `reverse_proxy 127.0.0.1:3001`.
#
# Create /opt/noxware/api.env from deploy/api.env.example first.

[Unit]
Description=Noxware API (Node/Express + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noxware
Group=noxware
WorkingDirectory=/opt/noxware
EnvironmentFile=/opt/noxware/api.env
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DATABASE_PATH=/opt/noxware/server/data/noxware.sqlite
Environment=CLIENT_ORIGIN=https://noxware.cc
Environment=PUBLIC_API_URL=https://api.noxware.cc
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3
# SQLite writes + npm runtime need these dirs writable
StateDirectory=noxware
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
