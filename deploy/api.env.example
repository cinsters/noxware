# Noxware API — production environment (deploy/api.env)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Core (set by compose, shown here for reference — do not duplicate) ---
# PORT=3001
# DATABASE_PATH=/app/server/data/noxware.sqlite
# CLIENT_ORIGIN=https://noxware.cc
# PUBLIC_API_URL=https://api.noxware.cc

# --- Secrets ---
JWT_SECRET=
MAIL_INBOUND_SECRET=

# --- NOWPayments (https://account.nowpayments.io/) ---
# Create the invoice API key in the dashboard; set the IPN callback URL to:
#   https://api.noxware.cc/api/webhooks/nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Registration ---
# Real invite codes, comma-separated. The seed default is intentionally NOT set in prod.
INVITE_SEED_CODES=
# Optional Cloudflare Turnstile (falls back to math captcha if unset)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Support inbox (MX → tickets) ---
# Must match the secret configured in the Cloudflare Email Worker.
SUPPORT_INBOUND_ADDRESS=support@noxware.cc
