[TEMPLATE]
# Server
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./server/data/noxware.sqlite

# Public URL of this API (needed so NOWPayments can reach your IPN webhook)
PUBLIC_API_URL=https://your-public-api.example.com
# Or set the IPN URL explicitly:
# NOWPAYMENTS_IPN_URL=https://your-public-api.example.com/api/webhooks/nowpayments

# NOWPayments (https://account.nowpayments.io/)
# For sandbox testing, also set: NOWPAYMENTS_API_BASE=https://api.sandbox.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Registration
INVITE_SEED_CODES=NOX-INVITE-2026
# Optional Cloudflare Turnstile (falls back to math captcha if unset)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Customer support — inbound email (MX → support tickets)
# Shared secret; your mail provider must send it as `X-Inbound-Secret` on every
# request to POST /api/mail/inbound. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_INBOUND_SECRET=
# The support inbox address this API should accept mail for — must match the
# address your Cloudflare Email Routing actually delivers, e.g. support@noxware.cc
SUPPORT_INBOUND_ADDRESS=

# Loader builds (binary hosting)
# Where uploaded builds are stored (default: server/data/builds). Max upload: 512 MB.
# BUILDS_DIR=./server/data/builds

# Launcher devices (HWID)
# Registered devices per account (default 2)
DEVICE_LIMIT_PER_USER=2
# Self-serve device reset cooldown in days (default 90 = once per 3 months)
DEVICE_RESET_COOLDOWN_DAYS=90
# Optional extra pepper for hashing HWIDs. If unset, JWT_SECRET is used.
# Change once BEFORE go-live; rotating it invalidates all registered devices.
# HWID_SALT=
